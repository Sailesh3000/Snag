{
  "manifest_version": 3,
  "name": "Snag",
  "version": "0.3.0",
  "key": "",
  "description": "AI job application copilot. Your profile and past answers stay on this device; AI answers come from your Snag subscription.",
  "permissions": ["activeTab", "storage", "scripting", "alarms", "identity", "unlimitedStorage"],
  "host_permissions": [
    "https://*.amazoncognito.com/*",
    "https://*.execute-api.us-east-1.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Snag — Click to toggle sidebar",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
